<Window x:Class="Ruler.Wpf.Views.SetSizeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Ruler.Wpf.Views"
        mc:Ignorable="d"
       Title="Set Custom Size" 
        Height="150" Width="280"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F5F5F5"
        BorderBrush="#1E1E1E"
        BorderThickness="1">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" Text="Width (px):" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="#1E1E1E"/>
        <TextBox Grid.Row="0" Grid.Column="1" x:Name="WidthInput"
                 Text="{Binding TargetWidth, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                 VerticalAlignment="Center" Height="24" Padding="3,0"
                 Focusable="True"/>

        <TextBlock Grid.Row="1" Grid.Column="0" Text="Height (px):" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="#1E1E1E"/>
        <TextBox Grid.Row="1" Grid.Column="1" 
                 Text="{Binding TargetHeight, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                 VerticalAlignment="Center" Height="24" Padding="3,0"/>

        <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" 
                    Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">

            <Button Content="Apply" Width="75" Height="24" Margin="0,0,8,0"
                    Command="{Binding SaveCommand}" IsDefault="True"/>

            <Button Content="Cancel" Width="75" Height="24" 
                    Command="{Binding CancelCommand}" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
