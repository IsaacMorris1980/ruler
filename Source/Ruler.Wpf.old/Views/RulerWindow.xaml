<Window x:Class="Ruler.Wpf.Views.RulerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Ruler.Wpf.Views"
        mc:Ignorable="d"
       Title="Ruler"           
        Topmost="True"                        
        ShowInTaskbar="True"
        
        Width="{Binding Width, Mode=TwoWay}"
        Height="{Binding Height, Mode=TwoWay}"
        Left="{Binding Left, Mode=TwoWay}"
        Top="{Binding Top, Mode=TwoWay}"
        Opacity="{Binding Opacity, Mode=TwoWay}"
        ContextMenuOpening="Window_ContextMenuOpening"
        ContextMenuClosing="Window_ContextMenuClosing">
    <Window.InputBindings>
        <KeyBinding Key="S" Modifiers="Control" Command="{Binding OpenSetSizeCommand}" />
    </Window.InputBindings>

    <Border BorderBrush="#111111" 
            BorderThickness="1" 
            Background="#F6F6F6" 
            CornerRadius="3"
            MouseLeftButtonDown="RulerWindow_MouseLeftButtonDown">
        <Border.ContextMenu>
            <ContextMenu>
                <MenuItem Header="Set Size... (Ctrl+S)" Command="{Binding OpenSetSizeCommand}" />
                <Separator />
                <MenuItem Header="Close Ruler" Click="CloseMenu_Click" />
            </ContextMenu>
        </Border.ContextMenu>

        <Grid>
            <Canvas x:Name="TickCanvas" Background="Transparent" IsHitTestVisible="False">
            </Canvas>

            <StackPanel Orientation="Horizontal" 
                        HorizontalAlignment="Center" 
                        VerticalAlignment="Center" 
                        IsHitTestVisible="False">
                <TextBlock Text="{Binding Width, StringFormat={}{0:0}}" 
                           FontSize="14" 
                           FontWeight="Bold" 
                           Foreground="#333333"/>
                <TextBlock Text=" px" 
                           FontSize="11" 
                           Foreground="#666666" 
                           VerticalAlignment="Bottom" 
                           Margin="0,0,0,2"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
