<Window x:Class="Ruler.Wpf.Calibaration"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Calibration" 
        WindowState="Maximized" 
        WindowStyle="None" 
        AllowsTransparency="True" 
        Background="#121212">

    <Grid>
        <!-- Background/Overlay Layer -->
        <Canvas x:Name="CalibrationCanvas">

            <!-- Central Instruction Area -->
            <StackPanel x:Name="InstructionOverlay" 
                        VerticalAlignment="Center" 
                        HorizontalAlignment="Center"
                        Width="Auto">

                <TextBlock x:Name="StatusText" 
                           Text="Calibration Starting..." 
                           FontSize="32" 
                           FontWeight="Bold"
                           HorizontalAlignment="Center" 
                           Foreground="White"/>

                <TextBlock x:Name="InstructionText" 
                           Text="Please follow the targets on the screen." 
                           FontSize="18" 
                           HorizontalAlignment="Center" 
                           Foreground="#AAAAAA"
                           Margin="0,20,0,0"/>

                <!-- Simple progress bar or visual indicator if needed -->
                <ProgressBar x:Name="CalibrationProgress" 
                             Width="200" 
                             Height="4" 
                             Margin="0,30,0,0" 
                             Background="#333333" 
                             BorderThickness="0"
                             Foreground="#007ACC"
                             Visibility="Visible"
                             IsIndeterminate="False"
                             Value="0"
                             Maximum="100"/>
            </StackPanel>

            <!-- The Calibration Target (Circle/Dot) -->
            <!-- This is usually moved around via code-behind using Canvas.SetLeft and Canvas.SetTop -->
            <Ellipse x:Name="CalibrationTarget" 
                     Width="40" 
                     Height="40" 
                     Fill="#FF4444" 
                     Stroke="White" 
                     StrokeThickness="2"
                     Visibility="Hidden">
                <Ellipse.Effect>
                    <DropShadowEffect BlurRadius="15" Color="#FF4444" ShadowDepth="0" Opacity="0.7"/>
                </Ellipse.Effect>
            </Ellipse>

        </Canvas>

        <!-- Exit Button (Top Right) -->
        <Button Content="✕" 
                HorizontalAlignment="Right" 
                VerticalAlignment="Top" 
                Margin="20" 
                Width="40" 
                Height="40" 
                Background="Transparent" 
                BorderThickness="0" 
                Foreground="#444444"
                Cursor="Hand"
                Click="ExitButton_Click" />
    </Grid>
</Window>