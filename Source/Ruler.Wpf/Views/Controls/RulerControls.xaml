<UserControl x:Class="Ruler.Wpf.Views.Controls.RulerControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid Background="Transparent">
        <!-- 
        1. Background Layer: Provides the solid color base for the ruler. 
        It also ensures the control has a visual presence.
        -->
        <Rectangle Fill="#F2F2F2" Stroke="#CCCCCC" StrokeThickness="0.5"/>

        <!-- 
        2. Ticks Layer: This Path element holds the geometry generated in C#.
        The Path is bound to the DrawingContext, making it highly performant for lines.
        -->
        <Path x:Name="RulerPath" 
              Stroke="Black" 
              StrokeThickness="1" 
              StrokeStartLineCap="Square" 
              StrokeEndLineCap="Square"/>

        <!-- 
        3. Labels Layer: This Canvas is used to position the TextBlocks (labels).
        It's crucial because Canvas allows us to use Canvas.SetLeft/Top 
        for absolute positioning of labels relative to the tick marks.
        
        NOTE: When the Orientation is Vertical, the C# code applies a RotateTransform(90)
        to this LabelsPanel to ensure the text runs parallel to the ruler length.
        -->
        <Canvas x:Name="LabelsPanel" Background="Transparent"/>

    </Grid>
</UserControl>
