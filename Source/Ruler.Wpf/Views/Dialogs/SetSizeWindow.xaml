<Window x:Class="Ruler.Wpf.Views.Dialogs.SetSizeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        >
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" 
                   Text="Enter Target Dimensions" 
                   FontSize="14" 
                   FontWeight="SemiBold" 
                   Margin="0,0,0,15" 
                   Foreground="#333333"/>

        <Grid Grid.Row="1" Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" 
                       Text="Width:" 
                       VerticalAlignment="Center" 
                       Margin="0,0,10,10" 
                       FontWeight="Medium"/>
            <TextBox Grid.Row="0" Grid.Column="1" 
                     Text="{Binding WidthInput, UpdateSourceTrigger=PropertyChanged}" 
                     Height="24" 
                     Margin="0,0,5,10" 
                     VerticalContentAlignment="Center"/>
            <TextBlock Grid.Row="0" Grid.Column="2" 
                       Text="{Binding SelectedStrategy.Abbreviation}" 
                       VerticalAlignment="Center" 
                       Margin="0,0,0,10" 
                       Foreground="Gray"/>

            <TextBlock Grid.Row="1" Grid.Column="0" 
                       Text="Height:" 
                       VerticalAlignment="Center" 
                       Margin="0,0,10,0" 
                       FontWeight="Medium"/>
            <TextBox Grid.Row="1" Grid.Column="1" 
                     Text="{Binding HeightInput, UpdateSourceTrigger=PropertyChanged}" 
                     Height="24" 
                     Margin="0,0,5,0" 
                     VerticalContentAlignment="Center"/>
            <TextBlock Grid.Row="1" Grid.Column="2" 
                       Text="{Binding SelectedStrategy.Abbreviation}" 
                       VerticalAlignment="Center" 
                       Foreground="Gray"/>
        </Grid>

        <StackPanel Grid.Row="2" Margin="0,0,0,25">
            <TextBlock Text="Measurement Unit:" 
                       Margin="0,0,0,5" 
                       FontWeight="Medium"/>
            <ComboBox ItemsSource="{Binding AvailableStrategies}"
                      SelectedItem="{Binding SelectedStrategy}"
                      DisplayMemberPath="Abbreviation" 
                      Height="26"/>
        </StackPanel>

        <StackPanel Grid.Row="3" 
                    Orientation="Horizontal" 
                    HorizontalAlignment="Right">
            <Button Content="OK" 
                    Click="OkButton_Click" 
                    Width="75" 
                    Height="24" 
                    IsDefault="True" 
                    Margin="0,0,10,0"/>
            <Button Content="Cancel" 
                    Click="CancelButton_Click" 
                    Width="75" 
                    Height="24" 
                    IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
