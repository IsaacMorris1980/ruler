<UserControl x:Class="Ruler.UI.Shared.CalibrationControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Ruler.UI.Shared"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Border BorderBrush="#333" BorderThickness="1" CornerRadius="12" Background="#1A1A1A">
        <Grid Margin="30">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0" Margin="0,0,0,20">
                <TextBlock Text="Physical Calibration" FontSize="24" FontWeight="Bold" Foreground="White"/>
                <TextBlock Text="Hold a standard credit card against the screen and drag the slider until the blue box matches the card's physical size exactly." 
                           TextWrapping="Wrap" Foreground="#AAA" Margin="0,5,0,0"/>
            </StackPanel>

            <!-- Calibration Area -->
            <Viewbox Grid.Row="1" Stretch="Uniform">
                <Grid VerticalAlignment="Center" HorizontalAlignment="Center">
                    <!-- The Virtual Credit Card -->
                    <Border x:Name="VirtualCard"
                            CornerRadius="11"
                            BorderBrush="#60a5fa"
                            BorderThickness="1"
                            Width="640" Height="404">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#FF2563EB" Offset="0"/>
                                <GradientStop Color="#FF1E40AF" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>

                        <Border.Effect>
                            <DropShadowEffect BlurRadius="15" Opacity="0.5" ShadowDepth="5"/>
                        </Border.Effect>

                        <Grid Margin="20">
                            <!-- Chip Mockup -->
                            <Border Width="45" Height="35" Background="#cc9933" 
                                    CornerRadius="5" HorizontalAlignment="Left" VerticalAlignment="Top" Opacity="0.8"/>
                            <TextBlock Text="•••• •••• •••• 4242" Foreground="#80ffffff" 
                                       FontFamily="Courier New" FontSize="14"
                                       VerticalAlignment="Bottom" HorizontalAlignment="Left" Margin="0,0,0,10"/>
                        </Grid>
                    </Border>
                </Grid>
            </Viewbox>

            <!-- Controls -->
            <StackPanel Grid.Row="2" Margin="0,20,0,0">
                <Grid Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Smaller" Foreground="#666" VerticalAlignment="Center"/>
                    <Slider x:Name="WidthSlider" Margin="22,-11,10,11"
                            Minimum="150" Maximum="600" Value="320" 
                            ValueChanged="WidthSlider_ValueChanged" Grid.ColumnSpan="2" />
                    <TextBlock Text="Larger" Foreground="#666" VerticalAlignment="Center" Grid.Column="2"/>
                </Grid>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Cancel" Click="Cancel_Click" Width="100" Height="35" 
                            Background="Transparent" Foreground="#AAA" BorderThickness="0" Margin="0,0,10,0"/>
                    <Button Content="Save Calibration" Click="Save_Click" Width="150" Height="35" 
                            Background="#2563eb" Foreground="White" FontWeight="Bold">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="6"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </StackPanel>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
