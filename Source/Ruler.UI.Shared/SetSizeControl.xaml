<UserControl x:Class="Ruler.UI.Shared.SetSizeControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Ruler.UI.Shared"
             mc:Ignorable="d" 
             d:DesignHeight="200" d:DesignWidth="300">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" Text="Width:" Margin="5" VerticalAlignment="Center"/>
        <TextBox x:Name="txtWidth" Grid.Row="0" Grid.Column="1" Margin="5" Width="100"/>

        <TextBlock Grid.Row="1" Grid.Column="0" Text="Height:" Margin="5" VerticalAlignment="Center"/>
        <TextBox x:Name="txtHeight" Grid.Row="1" Grid.Column="1" Margin="5" Width="100"/>

        <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="5">
            <Button x:Name="btnOk" Content="OK" Width="75" Margin="5" IsDefault="True"/>
            <Button x:Name="btnCancel" Content="Cancel" Width="75" Margin="5" IsCancel="True"/>
        </StackPanel>
    </Grid>
</UserControl>
